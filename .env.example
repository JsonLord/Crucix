# ============================================
# Hugging Face Space Monitor — Configuration
# ============================================
# Copy this file to .env and fill in your keys.

# === Hugging Face Configuration ===
# Your Hugging Face API token (requires read access)
HF_TOKEN=

# Comma-separated list of Hugging Face profiles/organizations to monitor
HF_PROFILES=huggingface,gradio

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=30

# === LLM Layer (optional) ===
# Provider options: anthropic | openai | gemini | codex
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex
LLM_MODEL=

# === Telegram Alerts (optional, requires LLM) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
